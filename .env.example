# Local development only — loopback dev secrets, never production credentials.
# For hosted mode, set ME_BACKEND_AUTH_MODE=hosted and the ME_BACKEND_OIDC_*
# variables instead (static trusted IdP config; no IdP is provisioned here).
# ME_BACKEND_AUTH_MODE=dev
ME_BACKEND_HOST=127.0.0.1
ME_BACKEND_PORT=8787
ME_BACKEND_DATA_DIR=./data
# Freshness window (seconds, 30-3600) behind server-side `online` in status.
# ME_BACKEND_STALE_AFTER_SECONDS=300
# Bootstrap secret that authorizes initial home registration. Generate fresh per env, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ME_BACKEND_HOME_SETUP_TOKEN=change-me-to-a-long-random-dev-secret
# Map of dev account bearer token -> accountId. Identity is derived server-side
# from the presented token; clients must never send account/user IDs as identity.
# Generate each token fresh per developer/machine; keep this file out of git
# (copy to .env, which is gitignored). Not required in hosted mode.
ME_BACKEND_DEV_ACCOUNTS_JSON={"dev-token-alice-CHANGE-ME-00000001":"acct_alice","dev-token-bob-CHANGE-ME-00000002":"acct_bob"}
# --- Hosted OIDC (instead of the dev lines above) ---
# ME_BACKEND_OIDC_ISSUER=https://issuer.example.test
# ME_BACKEND_OIDC_AUDIENCE=me-backend-api
# Static trusted JWKS (inline JSON or file path), OR fixed trusted JWKS URL
# (exactly one of the static pair or the URL; never a phone-supplied URL):
# ME_BACKEND_OIDC_JWKS={"keys":[...]}
# ME_BACKEND_OIDC_JWKS_FILE=/run/secrets/backend-jwks.json
# ME_BACKEND_OIDC_JWKS_URL=https://issuer.example.test/.well-known/jwks.json
# ME_BACKEND_OIDC_JWKS_TIMEOUT_MS=5000
# ME_BACKEND_OIDC_ALGORITHMS=RS256
# Public mobile login metadata (protocol account-auth-v1; all public values,
# no secrets — see docs/account-auth-v1.md). clientId MUST differ from the
# API audience above. Missing clientId/redirectUris → GET /v1/auth/config is
# 503 configure_not_ready (verification still works; never faked).
# ME_BACKEND_OIDC_CLIENT_ID=me-mobile-public-client-PLACEHOLDER
# ME_BACKEND_OIDC_SCOPES=openid profile email
# ME_BACKEND_OIDC_REDIRECT_URIS=myapp://auth/callback
# ME_BACKEND_AUTH_APP_SCHEME=myapp
# Optional provider hints (server-controlled only):
# ME_BACKEND_OIDC_EXTRA_AUDIENCES=
# ME_BACKEND_OIDC_EXPECT_TOKEN_USE=access
# Tests only, never production:
# ME_BACKEND_OIDC_ALLOW_INSECURE_ISSUER=1
